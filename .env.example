# Copy this file to .env.local for local testing with `vercel dev`.
# In production, set these under Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real values — .env / .env.local are already gitignored.

# ClickUp -> click your avatar (bottom left) -> Settings -> Apps -> API Token
# Personal tokens start with "pk_" and don't expire.
CLICKUP_API_TOKEN=pk_your_token_here

# The List that new contact-form enquiries should land in as tasks.
# Open the List in ClickUp, click "..." -> Copy link, the number after
# app.clickup.com/<team_id>/v/li/ is the List ID.
CLICKUP_LIST_ID=your_list_id_here

# The List that new careers/candidate applications should land in as tasks.
CLICKUP_CAREERS_LIST_ID=your_careers_list_id_here

# --- Optional: no-reply confirmation emails (via Resend, https://resend.com) ---
# Leave these unset to turn auto-replies off; the forms still work without them.
# Resend -> API Keys. Keys start with "re_".
RESEND_API_KEY=re_your_key_here
# Must be an address on a domain verified in Resend -> Domains.
AUTOREPLY_FROM=NextPath <noreply@nexpathsolution.com>
# Optional: where replies go if someone hits "Reply" anyway. Defaults to contact@nexpathsolution.com.
# AUTOREPLY_REPLY_TO=contact@nexpathsolution.com
