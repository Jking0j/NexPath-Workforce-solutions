# Copy this file to .env.local for local testing with `vercel dev`.
# In production, set these under Vercel -> Project -> Settings -> Environment Variables.
# Never commit the real values — .env / .env.local are already gitignored.

# ClickUp -> click your avatar (bottom left) -> Settings -> Apps -> API Token
# Personal tokens start with "pk_" and don't expire.
CLICKUP_API_TOKEN=pk_your_token_here

# The List that new contact-form enquiries should land in as tasks.
# Open the List in ClickUp, click "..." -> Copy link, the number after
# app.clickup.com/<team_id>/v/li/ is the List ID.
CLICKUP_LIST_ID=your_list_id_here
